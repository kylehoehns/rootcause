{
  "name": "rootcause-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "types": "json2ts -i ../contracts/county-indemnity.schema.json -o src/contracts.ts --bannerComment '// Generated from contracts/*.schema.json by `pnpm types`. Do not edit.'",
    "build": "pnpm types && tsc --noEmit && vite build",
    "lint": "biome check .",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
